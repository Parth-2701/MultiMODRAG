# Gemini API Key (Required for Tier 1 captioning, embeddings, and chat generation)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (Optional: Tier 2 Free Vision Models Fallback before Florence-2)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# MCP Server URL (Default: http://localhost:9090/sse)
MCP_SERVER_URL=http://localhost:9090/sse

# Optional Hugging Face Token
# HF_TOKEN=your_huggingface_token_here
