# ==============================================================================
# MultiMODRAG Environment Configuration
# ==============================================================================

# Required: Google AI Studio Gemini API Key (Tier 1 Captioning & Chat Generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenRouter API Key (Tier 2 Free Vision Models Fallback before Florence-2)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: FastMCP Tool Server SSE URL (default: http://localhost:9090/sse)
MCP_SERVER_URL=http://localhost:9090/sse

# Optional: Hugging Face Token (if accessing gated models)
# HF_TOKEN=your_huggingface_token_here

# Optional: Retrieval & Generation Hyperparameters
# ANSWER_MODEL=gemini-2.5-flash
# EMBED_MODEL=gemini-embedding-001
# EMBED_DIM=768
# WHISPER_MODEL_SIZE=base
# CLIP_MODE=deterministic
